# Firebase client SDK (safe to expose; restrict via Firebase API key restrictions + Security Rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK
#
# Local development:
#   Leave the two vars below empty and use Application Default Credentials.
#   Run `gcloud auth application-default login` once.
#
# Production (Netlify):
#   Set both vars in Netlify → Site settings → Environment variables.
#   FIREBASE_ADMIN_PRIVATE_KEY is multi-line; paste as-is (Netlify accepts
#   newlines) or escape newlines as \n (the code handles either).
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Shared secret protecting the media auto-purge endpoint
# (/api/cron/purge-media). Generate a long random string, e.g.
#   openssl rand -hex 32
# and set the same value in your scheduler's Authorization: Bearer header.
CRON_SECRET=
