# Firebase client SDK (safe to expose; restrict via Firebase API key restrictions + Security Rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK
#
# Local development:
#   Leave the two vars below empty and use Application Default Credentials.
#   Run `gcloud auth application-default login` once.
#
# Production (Netlify):
#   Set both vars in Netlify → Site settings → Environment variables.
#   FIREBASE_ADMIN_PRIVATE_KEY is multi-line; paste as-is (Netlify accepts
#   newlines) or escape newlines as \n (the code handles either).
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# VA Facilities API (developer.va.gov) — used only by
# `npm run import-va-facilities`. Free key, instant sandbox access.
VA_FACILITIES_API_KEY=
# Optional. Defaults to production; the script's --sandbox flag sets the
# sandbox host instead. A sandbox key 401s against production and vice versa.
# VA_FACILITIES_API_BASE=https://sandbox-api.va.gov/services/va_facilities/v1

# Anthropic API — used only by the admin resource-drafting page
# (/admin/resources/enrich). Read server-side only; never exposed to the
# browser, which is why it has no NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=
