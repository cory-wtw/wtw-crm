rules_version = '2';

// Storage rules for the social media wall. Files live under
// media/{uid}/{fileName}. The uploader must be signed in and can only write
// into their own folder; anyone signed in can read (the gallery renders via
// tokenized download URLs). Uploads are capped at 500 MB and must be an
// image or video — mirrors MEDIA_MAX_BYTES / mediaKindFromContentType.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    match /media/{uid}/{fileName=**} {
      allow read: if signedIn();

      allow write: if signedIn() &&
                      request.auth.uid == uid &&
                      request.resource.size < 500 * 1024 * 1024 &&
                      (request.resource.contentType.matches('image/.*') ||
                       request.resource.contentType.matches('video/.*'));

      // Deletes go through the Admin SDK (delete action + purge cron), which
      // bypasses these rules. Block client-side deletes.
      allow delete: if false;
    }

    // Veteran attachments (DD-214s, VA letters, ID scans, etc). Files live
    // under attachments/{veteranId}/{fileName}. Gated the same way as
    // media below: signedIn() only, not a role check — the `role` custom
    // claim is set once at provisioning (see createSession in
    // lib/firebase/session.ts) and never refreshed, so most existing
    // users' ID tokens don't carry it. The real access gate (CRM-only,
    // assignee/admin) lives in canEditVeteran + the veteran route, and
    // every Firestore write goes through the Admin SDK regardless.
    // Capped at 25 MB — mirrors ATTACHMENT_MAX_BYTES.
    match /attachments/{veteranId}/{fileName=**} {
      allow read: if signedIn();

      allow write: if signedIn() &&
                      request.resource.size < 25 * 1024 * 1024;

      // Deletes go through the Admin SDK. Block client-side deletes.
      allow delete: if false;
    }

    // Finance source documents (ledger exports, statements, receipts).
    // Files live under finance-records/{uid}/{fileName}. A signed-in user may
    // only write into their own folder; the role claim isn't reliable in ID
    // tokens (see attachments above), so the admin check happens in the
    // server action that records the upload — an upload it rejects is never
    // listed. Nobody reads these through the client SDK: downloads go
    // through /api/finances/records/{id}, which checks for admin. Capped at
    // 25 MB — mirrors RECORD_MAX_BYTES.
    match /finance-records/{uid}/{fileName=**} {
      allow read: if false;
      allow write: if signedIn() &&
                      request.auth.uid == uid &&
                      request.resource.size < 25 * 1024 * 1024;
      allow delete: if false;
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
