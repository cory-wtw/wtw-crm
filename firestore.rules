rules_version = '2';

// Loose authenticated-user rules. Tightened in the RBAC pass.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.role == 'admin';
    }

    match /users/{uid} {
      // Users can read their own user doc; admins (via Admin SDK / future UI)
      // create and edit. No client-side writes for now.
      allow read: if signedIn();
      allow write: if false;
    }

    match /invites/{email} {
      // Admin SDK only. Surface in /admin/users.
      allow read, write: if false;
    }

    match /veterans/{id} {
      allow read, create, update: if signedIn();
      allow delete: if false; // admin-only delete comes with RBAC

      match /encounters/{encounterId} {
        allow read, create, update: if signedIn();
        allow delete: if false;
      }
    }

    match /vsos/{id} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /phones/{id} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /rateTable/{rateCode} {
      // Read-only for the app. Seeded via Admin SDK.
      allow read: if signedIn();
      allow write: if false;
    }

    match /auditLog/{id} {
      // Written by the server (Admin SDK). Admins can read via the
      // /admin/audit page (which uses Admin SDK too, so this rule is
      // belt-and-suspenders against direct client reads).
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny-all for anything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
