rules_version = '2';

// The browser never touches Firestore: every read and write goes through the
// Admin SDK in Server Components and Server Actions, which bypass these rules.
// So nothing is granted to client SDKs at all.
//
// This matters because Google sign-in creates a Firebase Auth user for ANY
// Google account before createSession checks the invite allowlist. Rules
// keyed on `request.auth != null` would hand that stranger the whole
// database. Authorization lives in lib/permissions.ts, enforced server-side.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
