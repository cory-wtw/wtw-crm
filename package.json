    "enrich-urls": "tsx --env-file=.env.local --tsconfig=tsconfig.json scripts/enrich-urls.ts",
    "seed-resources": "tsx --env-file=.env.local --tsconfig=tsconfig.json scripts/seed-resources.ts",
    "deploy-rules": "firebase deploy --only firestore:rules,storage --project=wtw-crm-31aef"
  },
  "dependencies": {
